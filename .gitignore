__pycache__/
*.pyc
venv/
.venv/
*.egg-info/

# Archivos temporales que OpenDSS puede generar al correr simulaciones
temp_export/
*.dbl
*.log

# Diagramas HTML generados por generar_diagrama_unifilar() — son salida
# de ejecución, no código fuente. Los ejemplos en examples/ los regeneran
# cada vez que se corren.
diagrama_*.html
unifilar_tecnico.html
unifilar_tecnico.svg

# Workspace persistente y su SVG compañero. Son artefactos regenerables del
# circuito activo y no deben versionarse como código fuente.
workspace*.html
workspace*_unifilar.svg
